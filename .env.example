# Copy to .env and fill in. Used by docker-compose and scripts/docker-publish.sh.
# .env is gitignored — never commit real credentials.

# --- App ---
BUDDYDROP_BASE_URL=http://localhost:8080
APP_PORT=8080
# Set true only when served over HTTPS.
BUDDYDROP_COOKIE_SECURE=false

# --- Database ---
BUDDYDROP_DB_PASSWORD=change-me

# --- S3 ---
BUDDYDROP_S3_BUCKET=buddydrop-dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Auto-apply bucket CORS on startup (needs s3:PutBucketCORS).
BUDDYDROP_STORAGE_CONFIGURE_CORS=false

# --- Email ---  (log | ses | smtp)
BUDDYDROP_MAIL_PROVIDER=log
BUDDYDROP_MAIL_FROM=no-reply@buddydrop.app

# --- Docker Hub (for scripts/docker-publish.sh) ---
DOCKER_USERNAME=
# DOCKER_IMAGE=your-namespace/buddydrop   # defaults to $DOCKER_USERNAME/buddydrop
# DOCKER_PASSWORD=                          # a Docker Hub access token; enables auto docker login
# TAG=0.1.0
# PLATFORMS=linux/amd64,linux/arm64         # set to build multi-arch via buildx
