# Copy to deploy/.env.prod and fill in. Shipped to the EC2 host as `.env` by scripts/deploy-ec2.sh
# and read by deploy/docker-compose.prod.yml. deploy/.env.prod is gitignored — never commit secrets.

# --- Image to run (must be the one you pushed) ---
# deploy-ec2.sh overrides these with the tag it just pushed; they are here so `docker compose`
# on the host also works when run by hand.
DOCKER_IMAGE=your-namespace/buddydrop
TAG=latest

# --- Public address / TLS (Caddy auto-provisions Let's Encrypt for BUDDYDROP_DOMAIN) ---
BUDDYDROP_DOMAIN=drop.example.com
BUDDYDROP_BASE_URL=https://drop.example.com
BUDDYDROP_COOKIE_SECURE=true

# --- Database (external, e.g. RDS PostgreSQL) ---
BUDDYDROP_DB_URL=jdbc:postgresql://your-rds-endpoint.rds.amazonaws.com:5432/buddydrop
BUDDYDROP_DB_USER=buddydrop
BUDDYDROP_DB_PASSWORD=change-me

# --- S3 ---
BUDDYDROP_S3_BUCKET=buddydrop-prod
AWS_REGION=us-east-1
# Prefer an EC2 instance role over static keys; leave these empty to use the instance profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BUDDYDROP_STORAGE_CONFIGURE_CORS=false

# --- Email (ses | smtp | log) ---
# 'ses' uses the AWS credential chain (instance role or the keys above); no SMTP creds needed.
BUDDYDROP_MAIL_PROVIDER=ses
BUDDYDROP_MAIL_FROM=no-reply@buddydrop.app

# --- Social sign-in (optional) ---
# A provider appears on the login page only when its client id is set. Register
# <BUDDYDROP_BASE_URL>/login/oauth2/code/<google|apple|facebook|x> as the redirect URI with each.
BUDDYDROP_GOOGLE_CLIENT_ID=
BUDDYDROP_GOOGLE_CLIENT_SECRET=
BUDDYDROP_FACEBOOK_CLIENT_ID=
BUDDYDROP_FACEBOOK_CLIENT_SECRET=
# X: OAuth 2.0 "Web App" client; enable "Request email from users" in the app's auth settings.
BUDDYDROP_X_CLIENT_ID=
BUDDYDROP_X_CLIENT_SECRET=
# Apple: Services ID, Team ID, Key ID, and the AuthKey_<KEYID>.p8 contents (base64 body on one line,
# or PEM with literal \n separators). Apple requires HTTPS and a real domain — not localhost.
BUDDYDROP_APPLE_CLIENT_ID=
BUDDYDROP_APPLE_TEAM_ID=
BUDDYDROP_APPLE_KEY_ID=
BUDDYDROP_APPLE_PRIVATE_KEY=
