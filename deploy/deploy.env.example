# Copy to deploy/deploy.env and fill in. Sourced by scripts/deploy-ec2.sh.
# deploy/deploy.env is gitignored — it holds host/connection + Docker Hub config, not app secrets.

# --- EC2 host (SSH target) ---
EC2_HOST=ec2-1-2-3-4.compute-1.amazonaws.com
EC2_USER=ubuntu                     # 'ec2-user' on Amazon Linux, 'ubuntu' on Ubuntu AMIs
EC2_SSH_KEY=~/.ssh/buddydrop.pem    # omit to use ssh-agent / default keys
EC2_PORT=22
EC2_DEPLOY_DIR=/opt/buddydrop       # where deploy files live on the host

# --- Docker Hub (build + push; consumed by scripts/docker-publish.sh) ---
DOCKER_USERNAME=your-namespace
# DOCKER_IMAGE=your-namespace/buddydrop   # defaults to $DOCKER_USERNAME/buddydrop
# DOCKER_PASSWORD=dckr_pat_xxx            # access token → non-interactive `docker login` for build/push
# TAG=1.0.0                               # defaults to the pom version, else 'latest'
# Match your EC2 CPU arch so the pulled image runs: amd64 for x86, arm64 for Graviton.
# PLATFORMS=linux/amd64

# --- App runtime env shipped to the host (as .env) ---
APP_ENV_FILE=deploy/.env.prod

# Set to 'true' to deploy the current tag without rebuilding/pushing (e.g. a config-only redeploy).
# SKIP_PUSH=false
